!.owlbear/scratch/.instructions.md

# Briefs — transient template directory (renamed to draft-{name}/ at M1)
.owlbear/briefs/draft-new/

# Agent scratch/tmp output (quality-runner, coverage runs)
serve/.tmp-*
serve/cockpit/web/.owlbear-scratch-*
serve/cockpit/web/.owlbear/

# Temp test/debug output
*_output.txt
*_result.txt
*_err.txt
*_out.txt
*_test.txt
*_run.txt
*_run2.txt

# --- OwlBear managed paths ---

# Scratch / ad-hoc workspace
.owlbear/scratch/*
!.owlbear/scratch/.gitkeep
!.owlbear/scratch/.instructions.md

# Brief drafts (transient template directory)
.owlbear/briefs/draft-new/

# Knowledge and memory databases
.owlbear/knowledge/*.db
.owlbear/knowledge/vectors/
.owlbear/memory/*.db

# Lock files (transient runtime artifacts)
.owlbear/kanban/.activity.lock
.owlbear/kanban/.next_id.lock
.owlbear/kanban/tasks/.*.lock
.owlbear/kanban/archive/.*.lock
.owlbear/kanban/activity.jsonl

# --- OwlBear OpenSpec generated commands ---
.github/skills/openspec-*/
.github/prompts/opsx-*.prompt.md
