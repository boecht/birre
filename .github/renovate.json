{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":preserveSemverRanges"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "rangeStrategy": "update-lockfile",
  "packageRules": [
    {
      "description": "Freeze Python runtime floor to 3.14.x",
      "matchPackageNames": [
        "python"
      ],
      "matchManagers": [
        "pep621",
        "uv"
      ],
      "allowedVersions": ">=3.14.0 <3.15.0"
    },
    {
      "description": "Group all non-major Python updates",
      "matchManagers": [
        "pip_requirements",
        "pip-compile",
        "pep621",
        "uv"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "python minor/patch",
      "automerge": true
    },
    {
      "description": "Group all non-major npm updates",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm minor/patch",
      "automerge": true
    },
    {
      "description": "Group all non-major pre-commit hook updates",
      "matchManagers": [
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "pre-commit hooks",
      "automerge": true
    },
    {
      "description": "Group MegaLinter image updates with pre-commit hooks",
      "matchPackageNames": [
        "ghcr.io/oxsecurity/megalinter-python"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "pre-commit hooks",
      "automerge": true
    },
    {
      "description": "Major version bumps get individual PRs",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "MegaLinter Docker image in pre-commit local hook",
      "managerFilePatterns": [
        "/^\\.pre-commit-config\\.yaml$/"
      ],
      "matchStrings": [
        "ghcr\\.io/oxsecurity/megalinter-python:v(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "ghcr.io/oxsecurity/megalinter-python",
      "datasourceTemplate": "docker"
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/pyproject\\.toml$/"
    ]
  }
}
